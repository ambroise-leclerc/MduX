// The first screen this repository compiles into a committed artifact (#198).
//
// It draws the Row background the solver synthesises, a live video surface, a live waveform, a
// baked image, an explicitly positioned node whose rectangle a golden reference pins - and, since
// #235, a label. The label is what puts the text-budget stage over a committed artifact: its box is
// measured against the widest translation every approved locale carries, which is a check that had
// only ever run over packages a test built for itself.
//
// One property per line, matching TrustSC's own sources: its parser splits a component body line by
// line, so a fixture written the portable way is evidence about a shared grammar rather than about
// one implementation.
Screen EndoscopeMonitor {
    layout: Vertical { spacing: 0px; padding: 0px; }
    surface: 1280px, 720px;

    Row {
        id: topbar;
        height: 72px;
        background: Theme.Colors.TopbarBackground;

        Image {
            id: brand-mark;
            width: 240px;
            height: 72px;
            source: img("IMG-BRAND-MARK");
        }

        // The screen's one piece of text, and the reason it is here rather than anywhere more
        // decorative: it sits in a fixed-width box beside the brand mark, so the budget stage has a
        // resolved rectangle to measure rather than one the solver would have to invent. The key is
        // carried into the compiled screen; the words for it live in the text package, one per
        // approved locale, because a compiled screen is locale-free (ADR-011 as amended by #203).
        Label {
            id: screen-title;
            width: 1040px;
            height: 72px;
            text: t("STR-EM-TITLE");
            color: Theme.Colors.Title;
        }
    }

    VulkanViewport {
        id: endoscope-view;
        width: 1280px;
        height: 424px;
        stream_source: "ENDOSCOPE_PRIMARY";
    }

    // The safety-critical node, and the reason this screen has one: `goldens.json` should describe a
    // real screen rather than only a test fixture. Annotated and traced, so the sidecar carries an
    // entry saying where the insufflation reading must appear and in what tint - never what the
    // number says, because the number is live.
    //
    // What that entry does *not* have yet is a verifier reading it against a frame. This component
    // is deferred by the runtime, so there are no pixels to compare; the check ADR-012 describes
    // arrives with #16, over content that #17 teaches to draw.
    //
    // A NumericDisplay rather than a Label, still: its `template:` names a product template the
    // compiler cannot expand into code points, so it is the traceable component whose worst case no
    // budget can bound. That is a limit worth having in the screen rather than designed around.
    @safety_critical(cv_check: [Bounds, ColorHash])
    NumericDisplay {
        id: insufflation-pressure;
        width: 1280px;
        height: 96px;
        requirement: "REQ-EM-001";
        template: "TPL-PRESSURE-MMHG";
        source: "INSUFFLATION_PRESSURE";
        color: Theme.Colors.ScoreDigits;
    }

    // Positioned, so its rectangle is pinned by a golden reference: a waveform that drifts off its
    // band is the kind of regression a screenshot comparison catches and a unit test does not.
    SignalTrace {
        id: ecg-lead-ii;
        width: 1280px;
        height: 128px;
        position: 0px, 592px;
        stream_source: "ECG_LEAD_II";
        color: Theme.Colors.Nominal;
    }
}
