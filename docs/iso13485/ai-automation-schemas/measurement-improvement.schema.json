    "performance_metrics": {
      "type": "object",
      "description": "System performance monitoring and optimization metrics",
      "properties": {
        "system_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_name": {"type": "string"},
              "metric_category": {"type": "string", "enum": ["efficiency", "effectiveness", "quality", "compliance", "satisfaction"]},
