{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdux.dev/schemas/iso13485/product-realisation.schema.json",
  "title": "ISO 13485 Product Realisation Automation Schema",
  "description": "Comprehensive schema for automating ISO 13485 product realisation processes with AI-enhanced design controls, manufacturing intelligence, and supply chain optimization",
  "version": "1.0.0",
  "type": "object",
  "required": ["realisation_id", "product_specification", "design_controls", "manufacturing_controls", "supply_chain_management"],
  
  "properties": {
    "realisation_id": {
      "type": "string",
      "description": "Unique identifier for the product realisation process",
      "pattern": "^PR-[0-9]{4}-[0-9]{3}$"
    },
    
    "product_specification": {
      "type": "object",
      "description": "Comprehensive product specification and requirements",
      "required": ["product_name", "intended_use", "regulatory_classification", "safety_classification"],
      "properties": {
        "product_name": {"type": "string"},
        "product_version": {"type": "string"},
        "intended_use": {"type": "string"},
        "intended_patient_population": {"type": "string"},
        "clinical_benefits": {"type": "array", "items": {"type": "string"}},
        "regulatory_classification": {
          "type": "object",
          "properties": {
            "fda_classification": {"type": "string", "enum": ["Class_I", "Class_II", "Class_III"]},
            "eu_classification": {"type": "string", "enum": ["Class_I", "Class_IIa", "Class_IIb", "Class_III"]},
            "risk_class": {"type": "string", "enum": ["low", "medium", "high"]},
            "regulatory_pathway": {"type": "array", "items": {"type": "string"}}
          }
        },
        "safety_classification": {
          "type": "object",
          "properties": {
            "iec_62304_class": {"type": "string", "enum": ["Class_A", "Class_B", "Class_C"]},
            "safety_related": {"type": "boolean"},
            "essential_performance": {"type": "array", "items": {"type": "string"}},
            "hazard_categories": {"type": "array", "items": {"type": "string"}}
          }
        },
        "technical_specifications": {
          "type": "object",
          "properties": {
            "functional_requirements": {"type": "array", "items": {"type": "string"}},
            "performance_requirements": {"type": "array", "items": {"type": "string"}},
            "interface_requirements": {"type": "array", "items": {"type": "string"}},
            "usability_requirements": {"type": "array", "items": {"type": "string"}},
            "environmental_requirements": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    
    "design_controls": {
      "type": "object",
      "description": "AI-enhanced design control system",
      "required": ["design_planning", "design_inputs", "design_outputs", "design_verification", "design_validation"],
      "properties": {
        "design_planning": {
          "type": "object",
          "properties": {
            "design_phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phase_name": {"type": "string"},
                  "phase_objectives": {"type": "array", "items": {"type": "string"}},
                  "deliverables": {"type": "array", "items": {"type": "string"}},
                  "review_criteria": {"type": "array", "items": {"type": "string"}},
                  "verification_activities": {"type": "array", "items": {"type": "string"}},
                  "validation_activities": {"type": "array", "items": {"type": "string"}},
                  "ai_automation_level": {"type": "string", "enum": ["manual", "assisted", "automated", "intelligent"]}
                }
              }
            },
            "resource_allocation": {
              "type": "object",
              "properties": {
                "human_resources": {"type": "array", "items": {"type": "string"}},
                "technical_resources": {"type": "array", "items": {"type": "string"}},
                "budget_allocation": {"type": "object"},
                "timeline_optimization": {"type": "boolean"}
              }
            },
            "risk_management_integration": {
              "type": "object",
              "properties": {
                "risk_management_plan": {"type": "string"},
                "hazard_analysis_approach": {"type": "string"},
                "risk_control_strategy": {"type": "string"},
                "post_market_surveillance_plan": {"type": "string"},
                "ai_risk_analytics": {"type": "boolean"}
              }
            }
          }
        },
        "design_inputs": {
          "type": "object",
          "properties": {
            "input_categories": {
              "type": "object",
              "properties": {
                "functional_requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "requirement_id": {"type": "string"},
                      "description": {"type": "string"},
                      "source": {"type": "string"},
                      "rationale": {"type": "string"},
                      "acceptance_criteria": {"type": "string"},
                      "verification_method": {"type": "string"},
                      "validation_method": {"type": "string"},
                      "traceability_links": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                },
                "performance_requirements": {
                  "type": "array",
                  "items": {"$ref": "#/properties/design_controls/properties/design_inputs/properties/input_categories/properties/functional_requirements/items"}
                },
                "safety_requirements": {
                  "type": "array",
                  "items": {"$ref": "#/properties/design_controls/properties/design_inputs/properties/input_categories/properties/functional_requirements/items"}
                },
                "regulatory_requirements": {
                  "type": "array",
                  "items": {"$ref": "#/properties/design_controls/properties/design_inputs/properties/input_categories/properties/functional_requirements/items"}
                },
                "usability_requirements": {
                  "type": "array",
                  "items": {"$ref": "#/properties/design_controls/properties/design_inputs/properties/input_categories/properties/functional_requirements/items"}
                }
              }
            },
            "input_management": {
              "type": "object",
              "properties": {
                "completeness_validation": {"type": "boolean"},
                "consistency_checking": {"type": "boolean"},
                "traceability_management": {"type": "boolean"},
                "change_control_integration": {"type": "boolean"},
                "ai_analysis_tools": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "design_outputs": {
          "type": "object",
          "properties": {
            "output_categories": {
              "type": "object",
              "properties": {
                "design_specifications": {"type": "array", "items": {"type": "string"}},
                "drawings_schematics": {"type": "array", "items": {"type": "string"}},
                "software_architecture": {"type": "array", "items": {"type": "string"}},
                "manufacturing_specifications": {"type": "array", "items": {"type": "string"}},
                "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
                "labeling_instructions": {"type": "array", "items": {"type": "string"}},
                "risk_management_outputs": {"type": "array", "items": {"type": "string"}}
              }
            },
            "output_validation": {
              "type": "object",
              "properties": {
                "input_traceability": {"type": "boolean"},
                "manufacturing_adequacy": {"type": "boolean"},
                "acceptance_criteria_definition": {"type": "boolean"},
                "safety_characteristic_specification": {"type": "boolean"},
                "ai_validation_tools": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "design_verification": {
          "type": "object",
          "properties": {
            "verification_planning": {
              "type": "object",
              "properties": {
                "verification_strategy": {"type": "string"},
                "test_planning": {"type": "string"},
                "resource_requirements": {"type": "array", "items": {"type": "string"}},
                "timeline": {"type": "string"},
                "acceptance_criteria": {"type": "string"},
                "ai_test_generation": {"type": "boolean"}
              }
            },
            "verification_methods": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "method_name": {"type": "string"},
                  "method_type": {"type": "string", "enum": ["analysis", "inspection", "test", "demonstration"]},
                  "requirements_addressed": {"type": "array", "items": {"type": "string"}},
                  "procedure_reference": {"type": "string"},
                  "acceptance_criteria": {"type": "string"},
                  "automation_level": {"type": "string", "enum": ["manual", "semi_automated", "automated", "ai_enhanced"]}
                }
              }
            },
            "verification_results": {
              "type": "object",
              "properties": {
                "results_documentation": {"type": "string"},
                "pass_fail_criteria": {"type": "string"},
                "deviation_handling": {"type": "string"},
                "traceability_matrix": {"type": "string"},
                "ai_results_analysis": {"type": "boolean"}
              }
            }
          }
        },
        "design_validation": {
          "type": "object",
          "properties": {
            "validation_planning": {
              "type": "object",
              "properties": {
                "validation_strategy": {"type": "string"},
                "clinical_evaluation_plan": {"type": "string"},
                "user_needs_validation": {"type": "string"},
                "real_world_evidence_plan": {"type": "string"},
                "ai_validation_optimization": {"type": "boolean"}
              }
            },
            "clinical_evidence": {
              "type": "object",
              "properties": {
                "clinical_data_requirements": {"type": "array", "items": {"type": "string"}},
                "study_design": {"type": "string"},
                "endpoints": {"type": "array", "items": {"type": "string"}},
                "statistical_analysis_plan": {"type": "string"},
                "regulatory_consultation": {"type": "string"},
                "ai_clinical_analytics": {"type": "boolean"}
              }
            }
          }
        },
        "design_transfer": {
          "type": "object",
          "properties": {
            "transfer_planning": {
              "type": "object",
              "properties": {
                "transfer_criteria": {"type": "array", "items": {"type": "string"}},
                "manufacturing_readiness": {"type": "string"},
                "quality_system_readiness": {"type": "string"},
                "personnel_training": {"type": "string"},
                "ai_transfer_optimization": {"type": "boolean"}
              }
            },
            "manufacturing_validation": {
              "type": "object",
              "properties": {
                "process_validation": {"type": "string"},
                "equipment_qualification": {"type": "string"},
                "facility_qualification": {"type": "string"},
                "personnel_qualification": {"type": "string"}
              }
            }
          }
        }
      }
    },
    
    "manufacturing_controls": {
      "type": "object",
      "description": "AI-enhanced manufacturing control systems",
      "properties": {
        "production_planning": {
          "type": "object",
          "properties": {
            "production_processes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "process_name": {"type": "string"},
                  "process_description": {"type": "string"},
                  "input_materials": {"type": "array", "items": {"type": "string"}},
                  "output_products": {"type": "array", "items": {"type": "string"}},
                  "process_parameters": {"type": "object"},
                  "control_methods": {"type": "array", "items": {"type": "string"}},
                  "monitoring_requirements": {"type": "array", "items": {"type": "string"}},
                  "ai_process_control": {"type": "boolean"}
                }
              }
            },
            "quality_controls": {
              "type": "object",
              "properties": {
                "in_process_controls": {"type": "array", "items": {"type": "string"}},
                "final_inspection": {"type": "array", "items": {"type": "string"}},
                "statistical_process_control": {"type": "boolean"},
                "predictive_quality_systems": {"type": "boolean"},
                "ai_quality_analytics": {"type": "boolean"}
              }
            }
          }
        },
        "environmental_controls": {
          "type": "object",
          "properties": {
            "cleanroom_requirements": {
              "type": "object",
              "properties": {
                "cleanliness_class": {"type": "string"},
                "environmental_parameters": {"type": "object"},
                "monitoring_systems": {"type": "array", "items": {"type": "string"}},
                "control_systems": {"type": "array", "items": {"type": "string"}},
                "ai_environmental_control": {"type": "boolean"}
              }
            },
            "contamination_controls": {
              "type": "object",
              "properties": {
                "contamination_risks": {"type": "array", "items": {"type": "string"}},
                "control_measures": {"type": "array", "items": {"type": "string"}},
                "monitoring_methods": {"type": "array", "items": {"type": "string"}},
                "verification_activities": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "traceability_systems": {
          "type": "object",
          "properties": {
            "identification_systems": {
              "type": "object",
              "properties": {
                "unique_device_identification": {"type": "boolean"},
                "serialization_approach": {"type": "string"},
                "lot_control_system": {"type": "string"},
                "component_traceability": {"type": "boolean"},
                "ai_traceability_analytics": {"type": "boolean"}
              }
            },
            "data_collection": {
              "type": "object",
              "properties": {
                "manufacturing_data": {"type": "array", "items": {"type": "string"}},
                "quality_data": {"type": "array", "items": {"type": "string"}},
                "environmental_data": {"type": "array", "items": {"type": "string"}},
                "personnel_data": {"type": "array", "items": {"type": "string"}},
                "automated_data_capture": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    
    "supply_chain_management": {
      "type": "object",
      "description": "AI-enhanced supply chain and supplier management",
      "properties": {
        "supplier_management": {
          "type": "object",
          "properties": {
            "supplier_qualification": {
              "type": "object",
              "properties": {
                "qualification_criteria": {"type": "array", "items": {"type": "string"}},
                "assessment_methods": {"type": "array", "items": {"type": "string"}},
                "documentation_requirements": {"type": "array", "items": {"type": "string"}},
                "re_qualification_frequency": {"type": "string"},
                "ai_supplier_analytics": {"type": "boolean"}
              }
            },
            "supplier_auditing": {
              "type": "object",
              "properties": {
                "audit_frequency": {"type": "string"},
                "audit_scope": {"type": "array", "items": {"type": "string"}},
                "audit_criteria": {"type": "array", "items": {"type": "string"}},
                "corrective_action_management": {"type": "string"},
                "risk_based_auditing": {"type": "boolean"}
              }
            }
          }
        },
        "purchasing_controls": {
          "type": "object",
          "properties": {
            "purchasing_information": {
              "type": "object",
              "properties": {
                "product_specifications": {"type": "array", "items": {"type": "string"}},
                "quality_requirements": {"type": "array", "items": {"type": "string"}},
                "regulatory_requirements": {"type": "array", "items": {"type": "string"}},
                "change_control_requirements": {"type": "string"},
                "ai_specification_management": {"type": "boolean"}
              }
            },
            "incoming_inspection": {
              "type": "object",
              "properties": {
                "inspection_requirements": {"type": "array", "items": {"type": "string"}},
                "sampling_plans": {"type": "array", "items": {"type": "string"}},
                "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
                "non_conformance_handling": {"type": "string"},
                "ai_inspection_systems": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    
    "service_provision": {
      "type": "object",
      "description": "AI-optimized service provision and support",
      "properties": {
        "installation_services": {
          "type": "object",
          "properties": {
            "installation_requirements": {"type": "array", "items": {"type": "string"}},
            "verification_procedures": {"type": "array", "items": {"type": "string"}},
            "documentation_requirements": {"type": "array", "items": {"type": "string"}},
            "training_requirements": {"type": "array", "items": {"type": "string"}},
            "ai_installation_support": {"type": "boolean"}
          }
        },
        "servicing_activities": {
          "type": "object",
          "properties": {
            "service_procedures": {"type": "array", "items": {"type": "string"}},
            "maintenance_requirements": {"type": "array", "items": {"type": "string"}},
            "performance_verification": {"type": "array", "items": {"type": "string"}},
            "service_records": {"type": "array", "items": {"type": "string"}},
            "predictive_maintenance": {"type": "boolean"}
          }
        }
      }
    },
    
    "ai_automation_systems": {
      "type": "object",
      "description": "AI system integration and automation configuration",
      "properties": {
        "design_automation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_name": {"type": "string"},
              "automation_scope": {"type": "string"},
              "ai_technology": {"type": "string"},
              "validation_approach": {"type": "string"},
              "risk_controls": {"type": "array", "items": {"type": "string"}},
              "performance_metrics": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "manufacturing_automation": {
          "type": "array",
          "items": {"$ref": "#/properties/ai_automation_systems/properties/design_automation/items"}
        },
        "quality_automation": {
          "type": "array",
          "items": {"$ref": "#/properties/ai_automation_systems/properties/design_automation/items"}
        }
      }
    },
    
    "performance_monitoring": {
      "type": "object",
      "description": "Performance monitoring and improvement systems",
      "properties": {
        "key_performance_indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kpi_name": {"type": "string"},
              "measurement_method": {"type": "string"},
              "target_value": {"type": "string"},
              "measurement_frequency": {"type": "string"},
              "responsible_party": {"type": "string"},
              "improvement_actions": {"type": "array", "items": {"type": "string"}},
              "ai_analytics": {"type": "boolean"}
            }
          }
        },
        "continuous_improvement": {
          "type": "object",
          "properties": {
            "improvement_processes": {"type": "array", "items": {"type": "string"}},
            "feedback_mechanisms": {"type": "array", "items": {"type": "string"}},
            "innovation_systems": {"type": "array", "items": {"type": "string"}},
            "ai_improvement_recommendations": {"type": "boolean"}
          }
        }
      }
    }
  }
}