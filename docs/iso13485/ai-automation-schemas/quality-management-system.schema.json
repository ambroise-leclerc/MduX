{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdux.dev/schemas/iso13485/quality-management-system.schema.json",
  "title": "ISO 13485 Quality Management System Automation Schema",
  "description": "Comprehensive schema for automating ISO 13485 quality management system processes with AI optimization",
  "version": "1.0.0",
  "type": "object",
  "required": ["qms_id", "organisation_profile", "scope_definition", "process_architecture", "management_responsibility"],
  
  "properties": {
    "qms_id": {
      "type": "string",
      "description": "Unique identifier for the quality management system implementation",
      "pattern": "^QMS-[0-9]{4}-[0-9]{3}$"
    },
    
    "organisation_profile": {
      "type": "object",
      "description": "Comprehensive organisation profile for QMS tailoring",
      "required": ["name", "role", "regulatory_jurisdictions", "device_portfolio"],
      "properties": {
        "name": {"type": "string"},
        "role": {
          "type": "string",
          "enum": ["manufacturer", "authorised_representative", "importer", "distributor"]
        },
        "size": {
          "type": "string",
          "enum": ["micro", "small", "medium", "large"]
        },
        "regulatory_jurisdictions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["FDA", "CE", "Health_Canada", "TGA", "PMDA", "NMPA"]
          }
        },
        "device_portfolio": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device_name": {"type": "string"},
              "classification": {"type": "string", "enum": ["Class_I", "Class_IIa", "Class_IIb", "Class_III"]},
              "risk_class": {"type": "string", "enum": ["low", "medium", "high"]},
              "special_categories": {
                "type": "array",
                "items": {"type": "string", "enum": ["sterile", "implantable", "active", "software", "ivd"]}
              }
            }
          }
        }
      }
    },
    
    "scope_definition": {
      "type": "object",
      "description": "Automated scope determination and documentation",
      "required": ["scope_statement", "applicable_requirements", "exclusions"],
      "properties": {
        "scope_statement": {"type": "string"},
        "applicable_requirements": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"}
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clause": {"type": "string"},
              "justification": {"type": "string"},
              "regulatory_permission": {"type": "boolean"}
            }
          }
        },
        "regulatory_context": {
          "type": "object",
          "properties": {
            "primary_markets": {"type": "array", "items": {"type": "string"}},
            "regulatory_pathways": {"type": "array", "items": {"type": "string"}},
            "harmonized_standards": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    
    "process_architecture": {
      "type": "object",
      "description": "AI-optimized process architecture and interactions",
      "required": ["core_processes", "supporting_processes", "process_interactions"],
      "properties": {
        "core_processes": {
          "type": "object",
          "properties": {
            "management_processes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "process_name": {"type": "string"},
                  "owner": {"type": "string"},
                  "inputs": {"type": "array", "items": {"type": "string"}},
                  "outputs": {"type": "array", "items": {"type": "string"}},
                  "controls": {"type": "array", "items": {"type": "string"}},
                  "resources": {"type": "array", "items": {"type": "string"}},
                  "performance_indicators": {"type": "array", "items": {"type": "string"}},
                  "automation_level": {"type": "string", "enum": ["manual", "semi_automated", "automated", "ai_enhanced"]}
                }
              }
            },
            "realization_processes": {
              "type": "array",
              "items": {"$ref": "#/properties/process_architecture/properties/core_processes/properties/management_processes/items"}
            },
            "support_processes": {
              "type": "array", 
              "items": {"$ref": "#/properties/process_architecture/properties/core_processes/properties/management_processes/items"}
            },
            "measurement_processes": {
              "type": "array",
              "items": {"$ref": "#/properties/process_architecture/properties/core_processes/properties/management_processes/items"}
            }
          }
        },
        "supporting_processes": {
          "type": "object",
          "properties": {
            "document_control": {"$ref": "#/definitions/support_process"},
            "record_control": {"$ref": "#/definitions/support_process"},
            "internal_audit": {"$ref": "#/definitions/support_process"},
            "management_review": {"$ref": "#/definitions/support_process"},
            "corrective_action": {"$ref": "#/definitions/support_process"},
            "preventive_action": {"$ref": "#/definitions/support_process"}
          }
        },
        "process_interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_process": {"type": "string"},
              "target_process": {"type": "string"},
              "interaction_type": {"type": "string", "enum": ["input_output", "feedback", "control", "resource"]},
              "interface_description": {"type": "string"},
              "automation_level": {"type": "string", "enum": ["manual", "automated", "ai_enhanced"]}
            }
          }
        }
      }
    },
    
    "management_responsibility": {
      "type": "object",
      "description": "Management responsibility automation and tracking",
      "required": ["leadership_commitment", "customer_focus", "quality_policy", "planning", "organization"],
      "properties": {
        "leadership_commitment": {
          "type": "object",
          "properties": {
            "commitment_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidence_type": {"type": "string"},
                  "description": {"type": "string"},
                  "measurement_method": {"type": "string"},
                  "automated_tracking": {"type": "boolean"}
                }
              }
            },
            "communication_framework": {
              "type": "object",
              "properties": {
                "channels": {"type": "array", "items": {"type": "string"}},
                "frequency": {"type": "string"},
                "effectiveness_measurement": {"type": "string"},
                "automation_features": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "customer_focus": {
          "type": "object",
          "properties": {
            "customer_requirements": {
              "type": "object",
              "properties": {
                "identification_methods": {"type": "array", "items": {"type": "string"}},
                "analysis_approach": {"type": "string"},
                "tracking_system": {"type": "string"},
                "ai_enhancement": {"type": "boolean"}
              }
            },
            "satisfaction_monitoring": {
              "type": "object",
              "properties": {
                "measurement_methods": {"type": "array", "items": {"type": "string"}},
                "frequency": {"type": "string"},
                "analysis_approach": {"type": "string"},
                "improvement_integration": {"type": "string"}
              }
            }
          }
        },
        "quality_policy": {
          "type": "object",
          "properties": {
            "policy_statement": {"type": "string"},
            "compliance_elements": {"type": "array", "items": {"type": "string"}},
            "communication_strategy": {
              "type": "object",
              "properties": {
                "channels": {"type": "array", "items": {"type": "string"}},
                "understanding_verification": {"type": "string"},
                "effectiveness_measurement": {"type": "string"}
              }
            },
            "review_schedule": {"type": "string"}
          }
        },
        "planning": {
          "type": "object",
          "properties": {
            "quality_objectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "objective": {"type": "string"},
                  "measurable_target": {"type": "string"},
                  "responsible_party": {"type": "string"},
                  "timeline": {"type": "string"},
                  "monitoring_method": {"type": "string"},
                  "ai_tracking": {"type": "boolean"}
                }
              }
            },
            "qms_planning": {
              "type": "object",
              "properties": {
                "change_management": {"type": "string"},
                "integrity_maintenance": {"type": "string"},
                "resource_planning": {"type": "string"},
                "risk_considerations": {"type": "string"}
              }
            }
          }
        },
        "organization": {
          "type": "object",
          "properties": {
            "responsibility_authority": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {"type": "string"},
                  "responsibilities": {"type": "array", "items": {"type": "string"}},
                  "authorities": {"type": "array", "items": {"type": "string"}},
                  "independence_requirements": {"type": "string"}
                }
              }
            },
            "management_representative": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "responsibilities": {"type": "array", "items": {"type": "string"}},
                "authorities": {"type": "array", "items": {"type": "string"}},
                "reporting_structure": {"type": "string"}
              }
            }
          }
        }
      }
    },
    
    "resource_management": {
      "type": "object",
      "description": "AI-enhanced resource management and optimization",
      "properties": {
        "resource_planning": {
          "type": "object",
          "properties": {
            "human_resources": {
              "type": "object",
              "properties": {
                "competence_requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {"type": "string"},
                      "required_competencies": {"type": "array", "items": {"type": "string"}},
                      "assessment_methods": {"type": "array", "items": {"type": "string"}},
                      "training_requirements": {"type": "array", "items": {"type": "string"}},
                      "ai_optimization": {"type": "boolean"}
                    }
                  }
                },
                "training_effectiveness": {
                  "type": "object",
                  "properties": {
                    "measurement_methods": {"type": "array", "items": {"type": "string"}},
                    "evaluation_criteria": {"type": "array", "items": {"type": "string"}},
                    "improvement_process": {"type": "string"},
                    "ai_analytics": {"type": "boolean"}
                  }
                }
              }
            },
            "infrastructure": {
              "type": "object",
              "properties": {
                "facility_requirements": {"type": "array", "items": {"type": "string"}},
                "equipment_requirements": {"type": "array", "items": {"type": "string"}},
                "information_systems": {"type": "array", "items": {"type": "string"}},
                "maintenance_planning": {"type": "string"},
                "ai_optimization": {"type": "boolean"}
              }
            },
            "work_environment": {
              "type": "object",
              "properties": {
                "environmental_requirements": {"type": "array", "items": {"type": "string"}},
                "contamination_controls": {"type": "array", "items": {"type": "string"}},
                "monitoring_systems": {"type": "array", "items": {"type": "string"}},
                "ai_monitoring": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    
    "automation_configuration": {
      "type": "object",
      "description": "AI automation system configuration",
      "properties": {
        "ai_systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_name": {"type": "string"},
              "purpose": {"type": "string"},
              "ai_technology": {"type": "string", "enum": ["machine_learning", "natural_language_processing", "computer_vision", "expert_systems", "robotics"]},
              "automation_level": {"type": "string", "enum": ["assistant", "augmented", "automated", "autonomous"]},
              "validation_requirements": {"type": "array", "items": {"type": "string"}},
              "risk_controls": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "integration_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_1": {"type": "string"},
              "system_2": {"type": "string"},
              "integration_type": {"type": "string"},
              "data_flow": {"type": "string"},
              "validation_approach": {"type": "string"}
            }
          }
        }
      }
    },
    
    "compliance_framework": {
      "type": "object",
      "description": "Automated compliance monitoring and validation",
      "properties": {
        "regulatory_mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": {"type": "string"},
              "iso_clause": {"type": "string"},
              "regulatory_reference": {"type": "string"},
              "implementation_approach": {"type": "string"},
              "validation_method": {"type": "string"},
              "automation_level": {"type": "string"}
            }
          }
        },
        "compliance_monitoring": {
          "type": "object",
          "properties": {
            "monitoring_frequency": {"type": "string"},
            "assessment_methods": {"type": "array", "items": {"type": "string"}},
            "reporting_requirements": {"type": "array", "items": {"type": "string"}},
            "automated_alerts": {"type": "boolean"},
            "dashboard_configuration": {"type": "object"}
          }
        }
      }
    }
  },
  
  "definitions": {
    "support_process": {
      "type": "object",
      "properties": {
        "process_owner": {"type": "string"},
        "procedure_reference": {"type": "string"},
        "automation_features": {"type": "array", "items": {"type": "string"}},
        "performance_metrics": {"type": "array", "items": {"type": "string"}},
        "integration_points": {"type": "array", "items": {"type": "string"}}
      }
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date in ISO 8601 format (YYYY-MM-DD)"
    },
    "person": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string"},
        "role": {"type": "string"},
        "qualifications": {"type": "array", "items": {"type": "string"}},
        "organization": {"type": "string"},
        "contact_information": {"type": "string"}
      }
    }
  }
}